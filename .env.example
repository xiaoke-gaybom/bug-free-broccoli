# Anthropic Claude API key (model-driven semantic analysis).
# Get one at https://console.anthropic.com/. NEVER commit real keys.
ANTHROPIC_API_KEY=

# Optional: choose Claude model. Defaults to claude-3-5-sonnet-latest.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: override cache directory (defaults to <repo>/data/cache).
REVIEW_FORGE_CACHE_DIR=

# Optional: set to "1" to bypass cache during local dev.
REVIEW_FORGE_NO_CACHE=0

# Optional: App Store RSS page size (max 50, default 50).
APPSTORE_RSS_PAGE_SIZE=50

# Optional: Mock LLM mode for offline end-to-end testing.
# When set to "1", the pipeline routes all LLM calls to a canned offline
# responder (no API key, no network). Output is schema-validated and
# references real review ids — clearly labeled as "Mock (offline)" in
# provenance so it can never be confused with real model-driven analysis.
# Equivalent to running: npm run dev:mock
REVIEW_FORGE_MOCK_LLM=0
